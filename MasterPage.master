    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [{
    "@type": "Question",
    "name": "What types of addictions do you treat?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "We provide treatment for:

Alcohol addiction
Drug addiction (Heroin, Opium, Marijuana, etc.)
Prescription medicine abuse
Tobacco and nicotine addiction"
    }
  },{
    "@type": "Question",
    "name": "What is the treatment process?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Our treatment program typically includes:

Medical Detoxification - Safely removing toxins from the body.
Counseling & Therapy - Individual and group sessions to address emotional and psychological issues.
Rehabilitation Activities - Yoga, meditation, and skill-building.
Aftercare Support - Guidance for long-term recovery and relapse prevention."
    }
  },{
    "@type": "Question",
    "name": "How can I admit someone to the center?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "You can call our helpline or visit our center to discuss the patient’s condition. After a medical and psychological evaluation, we guide you through the admission process."
    }
  },{
    "@type": "Question",
    "name": "Do you have trained doctors and counselors?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Absolutely. Our team includes qualified doctors, psychiatrists, psychologists, and experienced counselors trained in addiction recovery."
    }
  },{
    "@type": "Question",
    "name": "How long does the recovery program last?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The duration varies depending on the patient’s condition and progress. On average, programs can last from 1 month to 6 months."
    }
  }]
}
    </script>

