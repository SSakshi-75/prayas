<%@ Page Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="tobacco-addication.aspx.cs" Inherits="tobacco_addication" %>

<asp:Content ID="Content1" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">

    <!-- Tobacco Addiction Hero Banner (Topic-Specific Design) -->
    <div class="container-fluid tobacco-hero-banner">
        <div class="container py-2">
            <div class="row align-items-center">
                <div class="col-lg-7 text-start wow fadeInLeft" data-wow-delay="0.1s">
                    <h1 class="alcohol-banner-title mb-2">Tobacco Addiction Treatment</h1>
                    <div class="alcohol-banner-divider mb-3"></div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb alcohol-banner-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="index.aspx"><i class="fa fa-home me-2"></i>Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="#">Pages</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Tobacco Addiction Treatment</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <!-- Tobacco Hero Banner End -->

    <!-- Tobacco Addiction Treatment Intro (Matches Luxury Clinical Design) -->
    <div class="container-fluid treatment-approach-section">
        <div class="treatment-fluid-bg-accent"></div>
        <div class="container py-3">
            <div class="row g-5 align-items-center">
                <!-- Left: Realistic User Image with Cyan Accent Blob -->
                <div class="col-lg-6 wow fadeInLeft" data-wow-delay="0.2s">
                    <div class="treatment-img-container">
                        
                        <div class="treatment-img-card">
                            <img src="img/tobacco-intro.jpg" class="treatment-main-img" alt="Tobacco Addiction Treatment - Prayas Nasha Mukti Kendra">
                        </div>
                    </div>
                </div>

                <!-- Right: Treatment Approach Content -->
                <div class="col-lg-6 wow fadeInRight" data-wow-delay="0.4s">
                    <div class="treatment-content-box">
                        <div class="treatment-badge-tag mb-2">Our Treatment Approach</div>
                        <h2 class="treatment-fresh-heading mb-3">Tobacco Addiction Treatment</h2>
                        <p class="treatment-fresh-desc mb-3">
                            Prayas Nasha Mukti Kendra offers specialized treatment for tobacco addiction as part of its comprehensive approach to substance abuse recovery. Tobacco addiction, while often less prioritized compared to other substances, poses significant health risks and can be challenging to overcome. The center's treatment program for tobacco addiction focuses on helping individuals quit smoking or using other forms of tobacco through a combination of medical, psychological, and behavioral strategies.
                        </p>
                        <p class="treatment-fresh-desc mb-4">
                            Prayas Nasha Mukti Kendra's approach to tobacco addiction treatment is designed to address the complex nature of tobacco dependency, offering a supportive and comprehensive pathway to quitting and maintaining long-term sobriety.
                        </p>
                        <a href="contact.aspx" class="btn-fresh-start">
                            <span>Learn More</span>
                            <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Treatment Section End -->

    <!-- Treatment Protocols & Components (Professional 7-Step Clinical Grid) -->
    <div class="container-fluid treatment-protocol-section py-5">
        <div class="container py-3">
            <!-- Section Title -->
            <div class="section-title text-center mb-5 wow fadeInUp" data-wow-delay="0.1s">
                <div class="treatment-badge-tag mb-2">STRUCTURED CESSATION PROTOCOL</div>
                <h2 class="treatment-fresh-heading mb-3">Tobacco Addiction Treatment at Prayas Nasha Mukti Kendra</h2>
                <p class="treatment-fresh-desc mx-auto mb-0" style="max-width: 820px;">
                    A comprehensive medical, therapeutic, and lifestyle roadmap to safely quit tobacco, overcome cravings, and restore lasting health.
                </p>
            </div>

            <!-- 7 Protocol Cards Grid -->
            <div class="row g-4">

                <!-- 1. Assessment and Evaluation -->
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="treatment-protocol-card">
                        <div class="treatment-protocol-card-header">
                            <div class="protocol-icon-circle">
                                <i class="fas fa-clipboard-check"></i>
                            </div>
                            <span class="protocol-step-num">01</span>
                        </div>
                        <h4 class="treatment-protocol-title">Assessment and Evaluation</h4>
                        <p class="treatment-protocol-desc mb-0">
                            Comprehensive evaluation of the individual's tobacco use history, addiction severity, and any co-occurring mental health conditions. Development of a tailored treatment plan based on the assessment, addressing specific needs and goals.
                        </p>
                    </div>
                </div>

                <!-- 2. Medical Support -->
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="treatment-protocol-card">
                        <div class="treatment-protocol-card-header">
                            <div class="protocol-icon-circle">
                                <i class="fas fa-prescription-bottle-alt"></i>
                            </div>
                            <span class="protocol-step-num">02</span>
                        </div>
                        <h4 class="treatment-protocol-title">Medical Support</h4>
                        <p class="treatment-protocol-desc mb-0">
                            Use of nicotine patches, gum, lozenges, or inhalers to reduce withdrawal symptoms and cravings. Prescription medications such as bupropion (Zyban) or varenicline (Chantix) to help manage cravings and withdrawal symptoms. Regular health check-ups to monitor progress and manage any side effects or health issues related to tobacco cessation.
                        </p>
                    </div>
                </div>

                <!-- 3. Counseling and Therapy -->
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="treatment-protocol-card">
                        <div class="treatment-protocol-card-header">
                            <div class="protocol-icon-circle">
                                <i class="fas fa-user-friends"></i>
                            </div>
                            <span class="protocol-step-num">03</span>
                        </div>
                        <h4 class="treatment-protocol-title">Counseling and Therapy</h4>
                        <p class="treatment-protocol-desc mb-0">
                            Techniques such as Cognitive Behavioral Therapy (CBT) to help individuals understand and change their smoking habits, triggers, and thought patterns. A counseling approach to enhance motivation and commitment to quitting tobacco. Supportive group sessions where individuals share experiences and strategies, providing mutual encouragement and accountability.
                        </p>
                    </div>
                </div>

                <!-- 4. Supportive Services -->
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="treatment-protocol-card">
                        <div class="treatment-protocol-card-header">
                            <div class="protocol-icon-circle">
                                <i class="fas fa-heartbeat"></i>
                            </div>
                            <span class="protocol-step-num">04</span>
                        </div>
                        <h4 class="treatment-protocol-title">Supportive Services</h4>
                        <p class="treatment-protocol-desc mb-0">
                            Guidance on developing healthy habits and routines to replace tobacco use, including stress management techniques and physical activities. Support in making dietary changes to manage weight and improve overall health, which can be a concern for those quitting tobacco.
                        </p>
                    </div>
                </div>

                <!-- 5. Relapse Prevention -->
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="treatment-protocol-card">
                        <div class="treatment-protocol-card-header">
                            <div class="protocol-icon-circle">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <span class="protocol-step-num">05</span>
                        </div>
                        <h4 class="treatment-protocol-title">Relapse Prevention</h4>
                        <p class="treatment-protocol-desc mb-0">
                            Training in techniques to handle cravings and avoid situations that trigger the urge to smoke. Continued counseling and check-ins to address any challenges and prevent relapse.
                        </p>
                    </div>
                </div>

                <!-- 6. Education and Awareness -->
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="treatment-protocol-card">
                        <div class="treatment-protocol-card-header">
                            <div class="protocol-icon-circle">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <span class="protocol-step-num">06</span>
                        </div>
                        <h4 class="treatment-protocol-title">Education and Awareness</h4>
                        <p class="treatment-protocol-desc mb-0">
                            Educational programs about the health risks of tobacco use, benefits of quitting, and strategies for maintaining abstinence. Information on how tobacco affects the body, the benefits of quitting, and the steps involved in cessation.
                        </p>
                    </div>
                </div>

                <!-- 7. Family Involvement (Full Width Featured Card) -->
                <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="treatment-protocol-card treatment-protocol-card-featured p-4 p-lg-5">
                        <div class="row align-items-center g-3 g-lg-4">
                            <div class="col-auto">
                                <div class="protocol-icon-circle" style="width: 60px; height: 60px; font-size: 26px;">
                                    <i class="fas fa-users"></i>
                                </div>
                            </div>
                            <div class="col">
                                <h4 class="treatment-protocol-title mb-2">Family Involvement</h4>
                                <p class="treatment-protocol-desc mb-0">
                                    Involving family members in the treatment process to improve support and address any relational issues related to tobacco use. Providing family members with information and strategies to support their loved one in quitting tobacco.
                                </p>
                            </div>
                            <div class="col-auto text-end">
                                <span class="protocol-step-num" style="font-size: 32px;">07</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- Treatment Protocols End -->

    <!-- Goals of Tobacco Addiction Treatment Section (Pillars & Recovery Commitment Banner) -->
    <div class="container-fluid treatment-goals-section py-5">
        <div class="container py-3">
            <!-- Section Title -->
            <div class="section-title text-center mb-5 wow fadeInUp" data-wow-delay="0.1s">
                <div class="treatment-badge-tag mb-2">CORE OBJECTIVES</div>
                <h2 class="treatment-fresh-heading mb-3">Goals of Tobacco Addiction Treatment</h2>
                <p class="treatment-fresh-desc mx-auto mb-0" style="max-width: 820px;">
                    Key recovery milestones designed to help you achieve lasting abstinence and lead a healthier, tobacco-free life.
                </p>
            </div>

            <!-- 4 Core Goals Cards -->
            <div class="row g-4">
                <!-- Goal 1 -->
                <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="goal-card h-100">
                        <div class="goal-icon-badge">
                            <i class="fas fa-smoking-ban"></i>
                        </div>
                        <h4 class="goal-title">Complete Tobacco Cessation</h4>
                        <p class="goal-desc mb-0">
                            Help individuals quit all forms of tobacco use and achieve lasting abstinence.
                        </p>
                    </div>
                </div>

                <!-- Goal 2 -->
                <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="0.2s">
                    <div class="goal-card h-100">
                        <div class="goal-icon-badge">
                            <i class="fas fa-lungs"></i>
                        </div>
                        <h4 class="goal-title">Health Improvement</h4>
                        <p class="goal-desc mb-0">
                            Enhance overall health and reduce the risk of tobacco-related diseases, such as heart disease, lung disease, and cancer.
                        </p>
                    </div>
                </div>

                <!-- Goal 3 -->
                <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                    <div class="goal-card h-100">
                        <div class="goal-icon-badge">
                            <i class="fas fa-brain"></i>
                        </div>
                        <h4 class="goal-title">Behavioral Change</h4>
                        <p class="goal-desc mb-0">
                            Address the psychological and behavioral aspects of tobacco addiction to support long-term recovery.
                        </p>
                    </div>
                </div>

                <!-- Goal 4 -->
                <div class="col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="0.4s">
                    <div class="goal-card h-100">
                        <div class="goal-icon-badge">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <h4 class="goal-title">Empowerment & Support</h4>
                        <p class="goal-desc mb-0">
                            Provide individuals with the tools, knowledge, and support needed to overcome addiction and lead a healthier, tobacco-free life.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Recovery Commitment Banner Box -->
            <div class="row mt-5 wow fadeInUp" data-wow-delay="0.2s">
                <div class="col-12">
                    <div class="goals-approach-banner">
                        <div class="row align-items-center g-4">
                            <div class="col-lg-2 text-center text-lg-start">
                                <div class="goals-banner-icon-box">
                                    <i class="fas fa-hand-holding-heart"></i>
                                </div>
                            </div>
                            <div class="col-lg-10">
                                <div class="goals-banner-sub mb-2">OUR TOBACCO CESSATION PROMISE</div>
                                <p class="goals-banner-desc mb-0">
                                    Prayas Nasha Mukti Kendra's approach to tobacco addiction treatment is designed to address the complex nature of tobacco dependency, offering a supportive and comprehensive pathway to quitting and maintaining long-term sobriety.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- Goals End -->

</asp:Content>